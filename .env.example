# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lead-desk

# At least 32 random characters — used to sign session JWTs
AUTH_SECRET=replace-this-with-a-long-random-secret-string

# Public domain / URL of this dashboard (builds the lead API URL easily).
# Use either form — both work:
#   APP_URL=https://leads.example.com
#   DOMAIN=leads.example.com
# Lead API becomes: https://leads.example.com/api/v1/leads
APP_URL=http://localhost:3000
# DOMAIN=leads.example.com

# Optional: used by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeNow1!
