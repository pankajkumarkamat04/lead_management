# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lead-desk

# At least 32 random characters — used to sign session JWTs
AUTH_SECRET=replace-this-with-a-long-random-secret-string

# Optional: used by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeNow1!
